############################################################
# Merkato Backend — .env sample
# Copy this file to .env and fill with your local values.
# This file contains only placeholders and is safe to commit.
############################################################

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/merkato
# Some scripts also read these aliases; keep them in sync if you use them.
MONGODB_URI=
DB_URI=

# PostgreSQL (subsystem #1 mirror scaffolding)
DATABASE_URL=postgresql://merkato:merkato@127.0.0.1:5433/merkato?schema=public
# Mirror modes: off | best_effort
ORDERS_PG_MIRROR_MODE=off
# Optional alias: if true and mode is unset, mode defaults to best_effort
ORDERS_PG_MIRROR_ENABLED=
# Optional: log successful mirror writes in backend logs
ORDERS_PG_MIRROR_LOG_SUCCESS=

# Customer order-history guarded serving experiment (bounded promotion window)
# Gate: off | ready
CUSTOMER_ORDER_HISTORY_PG_SERVING_EXPERIMENT_GATE=off
CUSTOMER_ORDER_HISTORY_PG_SERVING_EXPERIMENT_KILL_SWITCH=false
CUSTOMER_ORDER_HISTORY_PG_READINESS_MAX_SOURCE_MIRROR_DELTA_MS=2500
CUSTOMER_ORDER_HISTORY_PG_READINESS_MAX_COMPARATOR_MS=1500
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_WINDOW_START_AT=
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_WINDOW_END_AT=
# Optional test/rehearsal override; if blank current system time is used
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_WINDOW_NOW_AT=
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_WINDOW_APPROVED_ENVIRONMENT_ID=
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_WINDOW_ENVIRONMENT_ID=
# Explicit GO approval marker for post-window posture
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_WINDOW_GO_APPROVED=false
# Rehearsal switch for forced comparator/runtime-failure fallback path
CUSTOMER_ORDER_HISTORY_PG_PROMOTION_REHEARSAL_FORCE_COMPARATOR_FAILURE=false

# Client URL (used in emails/links)
CLIENT_URL=http://localhost:3000

# Auth
JWT_SECRET=your_jwt_secret_here

# Stripe (test keys from Stripe dashboard)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (e.g., Gmail app password or SMTP creds)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Azure Content Moderator (optional)
AZURE_CM_ENDPOINT=
AZURE_CM_KEY=

# OpenAI (optional features)
OPENAI_API_KEY=your_openai_api_key_here

# Test fixtures (convenience for local testing)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPass123!
TEST_USER_TOKEN=Bearer mocked-user-token
TEST_ADMIN_TOKEN=Bearer mocked-admin-token

# Checkout policy
# If true, require card payment details (Stripe) for all purchases.
# Keep false in development/tests to allow COD flows.
REQUIRE_CARD_PAYMENT=false

# Advanced/optional toggles
# E2E_NO_TXN=true       # Disable Mongo transactions in E2E if using standalone Mongo
# JEST_CLOSE_DB=true    # Close DB at the end of Jest runs (used in tasks)

# Notes:
# - For test runs, you can create .env.test.local to override values when NODE_ENV=test.
# - In CI, .env.test is generated by .github/workflows/backend-baseline.yml. See .env.test.example.
# - The supported runtime proof path for subsystem #1 is CI-only via
#   .github/workflows/pr-subsystem1-postgres-mirror-proof.yml.
# - Never commit real secrets. Ensure .env files are ignored by git.

