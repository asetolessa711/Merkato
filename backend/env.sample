## Backend environment template (copy to .env and fill real values)

# MongoDB
MONGO_URI=mongodb://localhost:27017/merkato_dev

# JWT
JWT_SECRET=replace-with-dev-secret

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# Client URL
CLIENT_URL=http://localhost:3000

# Email (Nodemailer)
EMAIL_USER=you@example.com
EMAIL_PASS=app-password-or-token

# OpenAI (optional)
OPENAI_API_KEY=sk-...

# Notes:
# - Keep your real values only in backend/.env (ignored by git).
# - Rotate any leaked keys immediately.