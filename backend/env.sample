############################################################
# Merkato Backend — .env sample
# Copy this file to .env and fill with your local values.
# This file contains only placeholders and is safe to commit.
############################################################

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/merkato
# Some scripts also read these aliases; keep them in sync if you use them.
MONGODB_URI=
DB_URI=

# Client URL (used in emails/links)
CLIENT_URL=http://localhost:3000

# Auth
JWT_SECRET=your_jwt_secret_here

# Stripe (test keys from Stripe dashboard)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (e.g., Gmail app password or SMTP creds)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Azure Content Moderator (optional)
AZURE_CM_ENDPOINT=
AZURE_CM_KEY=

# OpenAI (optional features)
OPENAI_API_KEY=your_openai_api_key_here

# Test fixtures (convenience for local testing)
TEST_USER_EMAIL=testuser@example.com
TEST_USER_PASSWORD=TestPass123!
TEST_USER_TOKEN=Bearer mocked-user-token
TEST_ADMIN_TOKEN=Bearer mocked-admin-token

# Checkout policy
# If true, require card payment details (Stripe) for all purchases.
# Keep false in development/tests to allow COD flows.
REQUIRE_CARD_PAYMENT=false

# Advanced/optional toggles
# E2E_NO_TXN=true       # Disable Mongo transactions in E2E if using standalone Mongo
# JEST_CLOSE_DB=true    # Close DB at the end of Jest runs (used in tasks)

# Notes:
# - For test runs, you can create .env.test.local to override values when NODE_ENV=test.
# - Never commit real secrets. Ensure .env files are ignored by git.

