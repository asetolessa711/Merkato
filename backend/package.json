{
  "name": "merkato-backend",
  "version": "1.0.1",
  "description": "Backend for Merkato Marketplace",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "dev:5001": "cross-env NODE_ENV=development PORT=5001 nodemon server.js",
    "start:5001": "cross-env NODE_ENV=development PORT=5001 node server.js",
    "start:5051": "cross-env NODE_ENV=development PORT=5051 node server.js",
    "start": "node server.js",
    "test:seed": "node tests/utils/seedTestData.js",
    "test:seed:utils": "node tests/utils/seedTestData.js",
    "seed:test": "curl -X POST http://localhost:5000/api/dev/seed",
    "test": "jest --config=./jest.config.backend.js --runInBand",
    "test:win": "cross-env JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand",
    "test:win:mem": "cross-env NODE_OPTIONS=--max-old-space-size=4096 JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand",
    "test:diag": "cross-env JEST_LOG_HANDLES=true jest --config=./jest.config.backend.js --runInBand --detectOpenHandles --logHeapUsage --no-cache",
    "test:debug": "jest --config=./jest.config.backend.js --runInBand --detectOpenHandles --no-cache",
  "test:ci": "cross-env JEST_FORCE_EXIT=true JEST_DISABLE_THRESHOLD=true jest --config=./jest.config.backend.js --runInBand",
  "test:one": "jest --config=./jest.config.backend.js --coverage=false --runInBand",
  "test:ci:cov": "cross-env JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand --coverage",
    "test:ci:cov:core": "cross-env JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand --coverage --testPathIgnorePatterns=searchRoutes\\.etag",
    "test:ci:heavy": "cross-env JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand --coverage=false tests/integration/searchRoutes.etag*.test.js",
    "test:ci:cov:hmem": "cross-env NODE_OPTIONS=--max-old-space-size=6144 JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand --coverage",
    "test:guardrails": "cross-env COVERAGE_GUARDRAILS=true jest --config=./jest.config.backend.js --runInBand",
    "test:ci:guardrails": "cross-env COVERAGE_GUARDRAILS=true JEST_FORCE_EXIT=true jest --config=./jest.config.backend.js --runInBand",
    "test:backend": "jest --config=./jest.config.backend.js",
    "pretest": "node seedUsers.js && node seedFeedback.js",
    "test:flow:auth": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@auth\" --runInBand --coverage --coverageDirectory=coverage/auth",
    "test:flow:checkout": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@checkout\" --runInBand --coverage --coverageDirectory=coverage/checkout",
    "test:flow:orders": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@orders\" --runInBand --coverage --coverageDirectory=coverage/orders",
    "test:flow:admin": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@admin\" --runInBand --coverage --coverageDirectory=coverage/admin",
    "test:flow:vendor": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@vendor\" --runInBand --coverage --coverageDirectory=coverage/vendor",
    "test:flow:payments": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@payments\" --runInBand --coverage --coverageDirectory=coverage/payments"
  },
  "keywords": [],
  "author": "Merkato Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.1",
    "moment": "^2.30.1",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.1",
    "puppeteer": "^24.8.2",
    "sharp": "^0.33.3",
    "stripe": "^18.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.0.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.1"
  }
}
