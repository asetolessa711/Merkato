{
  "name": "merkato-backend",
  "version": "1.0.1",
  "description": "Backend for Merkato Marketplace",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "dev:5001": "cross-env NODE_ENV=development PORT=5001 nodemon server.js",
    "start:5001": "cross-env NODE_ENV=development PORT=5001 node server.js",
    "start:5051": "cross-env NODE_ENV=development PORT=5051 node server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "pg:up": "docker compose -f docker-compose.postgres.yml up -d postgres",
    "pg:down": "docker compose -f docker-compose.postgres.yml down",
    "pg:logs": "docker compose -f docker-compose.postgres.yml logs -f postgres",
    "pg:mirror:check": "node scripts/postgres/checkOrderMirror.js",
    "pg:runtime:proof:env-check": "node scripts/postgres/checkRuntimeProofEnvironment.js",
    "pg:runtime:proof": "node scripts/postgres/runtimeProofOrderMirror.js",
    "test:seed": "node tests/utils/seedTestData.js",
    "test:seed:utils": "node tests/utils/seedTestData.js",
    "seed:test": "curl -X POST http://localhost:5000/api/dev/seed",
    "test": "jest --config=./jest.config.backend.js --runInBand",
    "test:compact": "cross-env PRETTY_REPORTER_MODE=compact jest --config=./jest.config.backend.js --runInBand",
    "test:quick": "jest --config=./jest.config.backend.js --runInBand --coverage=false",
    "test:quick:compact": "cross-env PRETTY_REPORTER_MODE=compact jest --config=./jest.config.backend.js --runInBand --coverage=false",
    "test:target": "jest --config=./jest.config.backend.js --runInBand --forceExit",
    "test:debug": "jest --config=./jest.config.backend.js --runInBand --detectOpenHandles",
    "test:backend": "jest --config=./jest.config.backend.js",
  "pretest": "node -e \"if (process.env.RUN_TEST_SEED==='true') { require('child_process').execSync('node seedUsers.js && node seedFeedback.js', { stdio: 'inherit' }); }\"",
  "test:flow:auth": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@auth\" --runInBand --coverage --coverageDirectory=coverage/auth",
  "test:flow:checkout": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@checkout\" --runInBand --coverage --coverageDirectory=coverage/checkout",
  "test:flow:orders": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@orders\" --runInBand --coverage --coverageDirectory=coverage/orders",
  "test:flow:admin": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@admin\" --runInBand --coverage --coverageDirectory=coverage/admin",
  "test:flow:vendor": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@vendor\" --runInBand --coverage --coverageDirectory=coverage/vendor",
  "test:flow:payments": "cross-env FLOW_COVERAGE=true jest --config=./jest.config.backend.js -t \"@payments\" --runInBand --coverage --coverageDirectory=coverage/payments"
  },
  "keywords": [],
  "author": "Merkato Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.1",
    "moment": "^2.30.1",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.17.1",
    "puppeteer": "^24.8.2",
    "stripe": "^18.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.0.2",
    "nodemon": "^3.0.1",
    "prisma": "^6.6.0",
    "supertest": "^7.1.1"
  }
}
