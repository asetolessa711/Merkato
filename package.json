{
  "name": "merkato-monorepo",
  "version": "1.1.9",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/start-dev.js",
    "db:bootstrap:dev": "npm --prefix backend run db:bootstrap:dev",
    "db:bootstrap:test": "npm --prefix backend run db:bootstrap:test",
    "db:bootstrap:e2e": "npm --prefix backend run db:bootstrap:e2e",
    "db:validate:dev": "npm --prefix backend run db:validate:dev",
    "db:validate:test": "npm --prefix backend run db:validate:test",
    "db:validate:e2e": "npm --prefix backend run db:validate:e2e",
    "verify:core": "node ./scripts/verify-core.js",
    "test:frontend": "cd frontend && npm test",
    "test:backend": "cd backend && npm test",
    "test:all": "node ./scripts/run-all-tests.js",
    "test:all:ps": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-all-tests.ps1",
    "test:e2e": "npm --prefix frontend run cy:run",
    "guard:focused": "node ./scripts/check-focused-tests.js",
    "guard:lint": "npm --prefix frontend run imports:scan",
    "guard:duplicates": "npm --prefix frontend run dup:scan",
    "precommit": "node -e \"console.log('Use Husky hooks instead of npm precommit');\"",
    "prepare": "husky",
    "prepush": "node -e \"console.log('Use Husky hooks instead of npm prepush');\"",
    "start:backend": "cd backend && node server.js",
    "start:frontend": "cd frontend && npm start"
  },
  "devDependencies": {
    "axios": "^1.11.0",
  "cypress": "^14.5.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "dependencies": {
    "openai": "^5.16.0"
  }
}
