#!/usr/bin/env sh

echo "husky pre-commit: guard + backend/frontend tests (quick)"
export CI=true
node scripts/check-focused-tests.js || exit 1

# Normalize imports and prevent duplicate .js/.jsx twins (prefer .jsx)
node scripts/fix-import-extensions.js || true
node scripts/check-no-js-jsx-twins.js || exit 1

# Prevent staging React components in .js files
node scripts/guard-react-in-js.js || exit 1

# Run backend tests; retry once with detectOpenHandles if they fail (flaky guard)
if ! npm --prefix backend run -s test; then
	echo "Backend tests failed. Retrying with --detectOpenHandles..."
	npm --prefix backend run -s test:debug || exit 1
fi

# Run frontend tests
npm --prefix frontend test --silent || exit 1
