#!/usr/bin/env bash
set -euo pipefail

# Block focused tests in JS/TS
if git diff --cached --name-only | grep -E "\.(js|jsx|ts|tsx)$" >/dev/null; then
  if git diff --cached -U0 | grep -E "(it|test|describe)\.only\(|\bfit\(|\bfdescribe\(" >/dev/null; then
    echo "[hook] Focused tests (.only/fit) found in staged changes. Please remove before committing." >&2
    exit 1
  fi
fi

# Block large Office binaries under docs/
if git diff --cached --name-only | grep -E "^docs/.*\.(docx|doc|pptx|ppt|xlsx|xls)$" >/dev/null; then
  echo "[hook] Office binaries under docs/ are ignored by .gitignore. Do not commit these files." >&2
  exit 1
fi

echo "[hook] pre-commit checks passed."
exit 0
